GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
# Optional: model for the brief (default claude-sonnet-5-5)
BRIEF_MODEL=
# Optional: how long a finished brief is served from cache before a fresh run (default 86400 = 24h)
BRIEF_TTL_SECONDS=
# Optional: how many briefs may be researched at once (default 5)
MAX_CONCURRENT_BRIEFS=
# Optional: Redis for the brief cache, learned sources, and the concurrency limit in production
# (local dev falls back to an in-memory map persisted to .cache/kv.json)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
