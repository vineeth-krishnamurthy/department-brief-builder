GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
# Brief storage (Supabase Postgres). Project URL and secret key from Project Settings > API Keys.
# Run supabase/schema.sql once in the SQL Editor. Without these, briefs work but are not stored.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: model for the brief (default claude-sonnet-5-5)
BRIEF_MODEL=
# Optional: how many briefs may be researched at once (default 5)
MAX_CONCURRENT_BRIEFS=
# Optional: Redis so the concurrency limit is global across server instances in production
# (without it, the limit applies per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
